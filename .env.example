# Production: Backend API URL (your Hostinger backend URL)
VITE_API_URL=https://api.yourdomain.com/api

# Development: Backend API URL (optional, defaults to /api for same-origin)
# Set this if your development backend runs on a different origin
# Example: VITE_DEV_API_URL=http://localhost:5000/api
VITE_DEV_API_URL=http://localhost:5000/api
